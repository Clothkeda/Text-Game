--- !u!114 &2068832491
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2068832484}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5dee1d7bae837074f88c11457bc60f7a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PlayerController
  ani: {fileID: 0}
  rBody: {fileID: 0}
  lastH: 0
  lastV: 0
  tText: {fileID: 319636591}
  isInteracting: 0
  isGameActive: 1
  dialoguePoints:
  - pointName: pointName2
    sentences:
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u5979\u5728\u4E66\u67B6\u4E0A\u7FFB\u7740\uFF0C\u7FFB\u5230\u4E86\u4E00\u672C\u65E7\u76F8\u518C\uFF09"
    - speakerName: "\u5343\u53F6"
      content: "\u55EF\uFF1F\u8FD9\u662F\u4EC0\u4E48\uFF1F"
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u5979\u6253\u5F00\u76F8\u518C\uFF0C\u91CC\u9762\u662F\u5F88\u591A\u5E74\u524D\u7684\u5B66\u751F\u7167\u7247\uFF09"
    - speakerName: "\u5343\u53F6"
      content: "\u54C7\uFF0C\u8FD9\u4E9B\u5B66\u751F\u770B\u8D77\u6765\u597D\u8001\u554A..."
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u5979\u7FFB\u5230\u4E00\u9875\uFF0C\u7A81\u7136\u505C\u4F4F\u4E86\uFF09"
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u7167\u7247\u4E0A\u662F\u4E00\u7FA4\u5C0F\u5B66\u751F\uFF0C\u5728\u5B66\u6821\u64CD\u573A\u4E0A\u5408\u5F71\uFF09"
    - speakerName: "\u5343\u53F6"
      content: " \u8FD9... \u8FD9\u662F..."
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u5979\u7684\u624B\u5F00\u59CB\u98A4\u6296\uFF09"
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u7167\u7247\u4E0B\u9762\u5199\u7740\uFF1A\u300C\u4E34\u6E0A\u5C0F\u5B66
        \u4E09\u5E74\u7EA7\u4E8C\u73ED \u5408\u5F71\u300D\uFF0C\u65C1\u8FB9\u6807\u6CE8\u4E86\u6BCF\u4E2A\u5B66\u751F\u7684\u540D\u5B57\uFF09"
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u5C0F\u5973\u5B69\u7684\u540D\u5B57\u65C1\u8FB9\u5199\u7740\uFF1A\u5343\u53F6\u30FB\u5C0F\u67DA\uFF09"
    - speakerName: "\u5343\u53F6"
      content: "\u5C0F\u67DA..."
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u6797\u6DF1\u542C\u5230\u58F0\u97F3\uFF0C\u8D70\u4E86\u8FC7\u6765\uFF09"
    - speakerName: "\u6797\u6DF1"
      content: "\u600E\u4E48\u4E86\uFF1F"
    - speakerName: "\u5343\u53F6"
      content: "\u8FD9\u662F... \u6211\u59B9\u59B9..."
    - speakerName: "\u6797\u6DF1"
      content: "\u4F60\u59B9\u59B9\uFF1F"
    - speakerName: "\u5343\u53F6"
      content: "\u55EF... \u5979\u53EB\u5C0F\u67DA\uFF0C\u662F\u6211\u7684\u53CC\u80DE\u80CE\u59B9\u59B9...
        \u5341\u5E74\u524D\u5931\u8E2A\u4E86..."
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u5979\u770B\u7740\u7167\u7247\uFF0C\u773C\u6CEA\u6B62\u4E0D\u4F4F\u5730\u6D41\uFF09"
    - speakerName: "\u5343\u53F6"
      content: "\u8B66\u5BDF\u627E\u4E86\u597D\u4E45\u90FD\u6CA1\u627E\u5230... \u5927\u5BB6\u90FD\u8BF4\u5979\u53EF\u80FD\u5DF2\u7ECF..."
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u5979\u8BF4\u4E0D\u4E0B\u53BB\u4E86\uFF09"
    - speakerName: "\u5343\u53F6"
      content: "\u6211\u4E5F\u4E0D\u77E5\u9053... \u6211\u4EEC\u5C0F\u65F6\u5019\u4ECE\u6765\u6CA1\u5728\u8FD9\u91CC\u4E0A\u8FC7\u5B66\u554A..."
    isCompleted: 0
  - pointName: pointName1
    sentences:
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u6797\u6DF1\u7FFB\u4E86\u7FFB\u65C1\u8FB9\u7684\u6863\u6848\uFF09"
    - speakerName: "\u6797\u6DF1"
      content: "\u5343\u53F6... \u4F60\u59B9\u59B9\u7684\u540D\u5B57\uFF0C\u4E5F\u5728\u5931\u8E2A\u540D\u5355\u91CC\u3002"
    - speakerName: "\u5343\u53F6"
      content: "\u4EC0\u4E48\uFF1F"
    - speakerName: "\u6797\u6DF1"
      content: "\u5341\u5E74\u524D\uFF0C\u8FD9\u6240\u5B66\u6821\u91CC\u524D\u540E\u6709\u597D\u51E0\u4E2A\u5973\u751F\u5931\u8E2A\uFF0C\u5176\u4E2D\u4E00\u4E2A...
        \u5C31\u662F\u5343\u53F6\u5C0F\u67DA\u3002"
    - speakerName: "\u5343\u53F6"
      content: "\u600E\u4E48\u4F1A... \u600E\u4E48\u4F1A\u8FD9\u6837..."
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u5979\u60F3\u8D77\u4E86\u4EC0\u4E48\uFF09"
    - speakerName: "\u5343\u53F6"
      content: "\u96BE\u9053\u8BF4... \u59B9\u59B9\u5F53\u5E74\u5C31\u662F\u88AB\u5E26\u5230\u8FD9\u91CC\u7684\uFF1F"
    - speakerName: "\u6797\u6DF1"
      content: "\u5F88\u6709\u53EF\u80FD\u3002"
    - speakerName: "\u5343\u53F6"
      content: "\u90A3\u5979... \u5979\u73B0\u5728..."
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u5979\u8BF4\u4E0D\u51FA\u53E3\uFF09"
    - speakerName: "\u6797\u6DF1"
      content: "... \u73B0\u5728\u8FD8\u4E0D\u786E\u5B9A\u3002"
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u4ED6\u770B\u7740\u5343\u53F6\uFF0C\u8BED\u6C14\u8F6F\u4E86\u4E0B\u6765\uFF09"
    - speakerName: "\u6797\u6DF1"
      content: "\u5982\u679C\u4F60\u60F3\u56DE\u53BB\u7684\u8BDD..."
    - speakerName: "\u5343\u53F6"
      content: "\u4E0D\uFF01\u6211\u4E0D\u56DE\u53BB\uFF01"
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u5979\u7684\u773C\u795E\u53D8\u5F97\u575A\u5B9A\uFF09"
    - speakerName: "\u5343\u53F6"
      content: "\u6211\u4E00\u5B9A\u8981\u67E5\u51FA\u771F\u76F8\u3002\u6211\u8981\u77E5\u9053...
        \u59B9\u59B9\u5F53\u5E74\u5230\u5E95\u53D1\u751F\u4E86\u4EC0\u4E48\u3002"
    - speakerName: "\u6797\u6DF1"
      content: "... \u597D\u3002"
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u4ED6\u7EE7\u7EED\u7FFB\u627E\u6587\u4EF6\uFF09"
    isCompleted: 0
  - pointName: pointName3
    sentences:
