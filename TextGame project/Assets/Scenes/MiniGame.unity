      content: "\u4F60\u770B\u90A3\u5E45\u753B\u3002"
    - speakerName: "\u65C1\u767D"
      content: "\uFF08\u5899\u4E0A\u6302\u7740\u4E00\u5E45\u65E7\u753B\uFF0C\u753B\u7684\u662F\u949F\u697C\uFF09"
